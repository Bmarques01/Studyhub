# Copie este arquivo para .env (sem ".exemplo") e preencha. O .env nunca vai para o GitHub.

# Chave da API do Claude: criada em platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# Por onde a IA gera: "assinatura" (padrão: o Claude Code deste computador, gasta o limite do seu plano)
# ou "api" (paga por uso com a chave acima; é o que vale num servidor na internet)
IA_MODO=assinatura

# Opcional: caminho do programa claude, se o Studyhub não achar sozinho (ele procura na extensão do VS Code)
# CLAUDE_CAMINHO=
